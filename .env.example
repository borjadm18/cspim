VITE_SUPABASE_URL=https://your-project.supabase.co
# Usa la clave pública del cliente de Supabase (publishable/anon pública)
VITE_SUPABASE_ANON_KEY=your-publishable-key-publica

VITE_CATALOG_ACCESS_MODE=admin
VITE_CATALOG_TENANTS_JSON=[{"id":"default","label":"Tenant por defecto","description":"Usa la configuración activa del backend"},{"id":"tres-griferia","label":"TRES Grifería","description":"Tenant Bluestone PROD"},{"id":"tres-griferia-test","label":"TRES Grifería TEST","description":"Tenant Bluestone TEST"}]
VITE_CATALOG_SOURCE_MODE=remote
VITE_CATALOG_ALLOW_REMOTE_DEV=true

# Use one of these approaches on the server:
# 1) Single tenant:
# BLUESTONE_CLIENT_ID=
# BLUESTONE_CLIENT_SECRET=
# BLUESTONE_ORG_ID=
# BLUESTONE_ENV=test
# BLUESTONE_CONTEXT=en
#
# 2) Multi-tenant JSON:
# BLUESTONE_TENANTS_JSON={
#   "default":{"clientId":"","clientSecret":"","orgId":"","env":"test","context":"en"},
#   "tres-griferia":{"clientId":"your-client-id-here","clientSecret":"","orgId":"your-org-id-here","env":"prod","context":"en"},
#   "tres-griferia-test":{"clientId":"your-client-id-here","clientSecret":"","orgId":"your-org-id-here","env":"test","context":"en"}
# }
